---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/categories';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  // 글이 없는 카테고리는 페이지를 만들지 않는다. 목록 페이지와 사이드바는 이미
  // 걸러내고 있어서 어디에서도 링크되지 않는데, 사이트맵에는 올라가 크롤러와 AI에게
  // 빈 페이지로 노출된다. categories.ts에는 그대로 두므로 첫 글이 생기면 다시 생긴다.
  return categories
    .map((cat) => ({
      params: { category: cat.slug },
      props: {
        label: cat.label,
        intro: cat.intro ?? cat.description,
        posts: posts
          .filter((p) => p.data.category === cat.slug)
          .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
      },
    }))
    .filter((entry) => entry.props.posts.length > 0);
}

const { label, intro, posts } = Astro.props;

// 설명을 넘기지 않으면 모든 카테고리가 사이트 전역 기본값을 물려받아, 허브 페이지들의
// 메타 설명이 서로 완전히 같아진다. 홈·llms.txt와 같은 문장을 써서 주제를 구분한다.
const description = `${intro.replace(/\s+/g, ' ').trim()} 총 ${posts.length}편.`;
---

<BaseLayout title={label} description={description}>
  <h1 class="page-title">{label}</h1>
  {/* 빈 카테고리는 getStaticPaths에서 걸러지므로 '글 없음' 분기는 두지 않는다 */}
  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-item">
        <a href={`/blog/${post.id}`} class="post-item-link" aria-label={post.data.title}></a>
        <span class="post-item-date">
          {post.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
        </span>
        <span class="post-item-title">
          {post.data.title}
        </span>
        {post.data.description && (
          <p class="post-item-desc">{post.data.description}</p>
        )}
        {post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((tag) => (
              <a href={`/tags/${tag}`} class="tag">{tag}</a>
            ))}
          </div>
        )}
      </li>
    ))}
  </ul>
</BaseLayout>
