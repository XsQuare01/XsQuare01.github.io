---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { tagStyle } from '../../utils/tagColor';
import { getCategoryLabel } from '../../data/categories';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 태그 페이지도 설명을 넘기지 않으면 전부 같은 전역 기본값을 쓴다. 어떤 카테고리의
// 글이 몇 편 모여 있는지를 담아 페이지마다 구별되게 한다.
const tagCategories = [
  ...new Set(sorted.map((p) => p.data.category).filter(Boolean)),
].map((slug) => getCategoryLabel(slug as string));
const description =
  `${tag} 태그가 붙은 글 ${sorted.length}편` +
  `${tagCategories.length > 0 ? ` (${tagCategories.join(', ')})` : ''}. ` +
  '계산 이론·암호학·알고리즘을 정의부터 증명까지 정리하는 학습 노트.';
---

<BaseLayout title={`#${tag}`} description={description}>
  <h1 class="page-title"># {tag}</h1>
  <ul class="post-list">
    {sorted.map((post) => (
      <li class="post-item">
        <a href={`/blog/${post.id}`} class="post-item-link" aria-label={post.data.title}></a>
        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
          <span class="post-item-date">
            {post.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
          {post.data.category && (
            <a href={`/categories/${post.data.category}`} class="post-category-badge" style={tagStyle(post.data.category)}>
              {getCategoryLabel(post.data.category)}
            </a>
          )}
        </div>
        <span class="post-item-title">
          {post.data.title}
        </span>
        {post.data.description && (
          <p class="post-item-desc">{post.data.description}</p>
        )}
      </li>
    ))}
  </ul>
</BaseLayout>
