---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, getCategoryLabel } from '../data/categories';
import { tagStyle } from '../utils/tagColor';

const allPosts = await getCollection('posts');

const recentPosts = [...allPosts]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const totalPosts = allPosts.length;

const categoryCounts = categories
  .map((cat) => ({
    ...cat,
    count: allPosts.filter((p) => p.data.category === cat.slug).length,
  }))
  .filter((cat) => cat.count > 0);

const maxCount = Math.max(...categoryCounts.map((c) => c.count), 1);

const FEATURED_IDS = ['rsa', 'algo-orientation'];
const featuredPosts = FEATURED_IDS.map((id) => allPosts.find((p) => p.id === id)).filter(Boolean);
const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

// 홈 구조화 데이터 — 사이트(WebSite)와 저자(Person) 엔티티
const siteUrl = Astro.site?.toString() ?? 'https://xsquare01.github.io/';
const homeJsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'XsQuare01',
    alternateName: 'XsQuare01 학습 노트',
    url: siteUrl,
    inLanguage: 'ko',
    description: '계산 이론·암호학·알고리즘을 정의부터 증명까지 정리하는 학습 노트',
    author: { '@type': 'Person', name: 'XsQuare01', url: siteUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'XsQuare01',
    url: siteUrl,
    image: 'https://github.com/XsQuare01.png',
    // sameAs가 없으면 이 사이트의 저자와 GitHub 계정을 같은 인물로 묶을 근거가 없다.
    sameAs: ['https://github.com/XsQuare01'],
    knowsAbout: ['계산 이론', '암호학', '알고리즘', '정수론', '복잡도', '그리디'],
  },
]);

// 홈 제목은 사이트 주제를 그대로 적는다. "홈"이라고만 두면 페이지 구조(카테고리 탭·
// 링크 피드·카운트 막대)와 겹쳐 일반 포털 인덱스로 읽힌다.
// 홈에서 주제를 문장으로 소개한다. categories.ts의 description은 목록 페이지용이라
// 짧고 일반적이어서, 여기서는 실제로 다루는 개념 이름을 넣어 주제를 드러낸다.
const topicIntros: Record<string, string> = {
  theory:
    '유한 오토마타에서 튜링 기계까지 계산 모델을 차례로 쌓아 올리고, 결정 가능성과 복잡도 클래스로 「풀 수 있는 문제」의 경계를 그립니다. 집합의 농도처럼 그 경계를 떠받치는 수학도 함께 다룹니다.',
  cryptography:
    '나눗셈 정리와 합동식, 페르마 소정리와 중국인의 나머지 정리에서 시작해 RSA·ElGamal·Diffie-Hellman을 직접 구성합니다. 해시와 전자 서명, 영지식 증명까지 이어집니다.',
  algorithm:
    '분할 정복·그리디·동적 계획법을 설계 전략으로 묶어 정리합니다. 정렬과 선택, 최단 경로와 최소 신장 트리, 가장 가까운 점 쌍과 볼록 껍질을 왜 그 방법이 옳은지까지 증명합니다.',
};
const homeTopics = categoryCounts.filter((cat) => topicIntros[cat.slug]);

const homeTitle = '계산 이론·암호학·알고리즘 학습 노트';
const homeDescription =
  '계산 이론, 암호학, 알고리즘을 정의부터 증명까지 직접 풀어 정리하는 한국어 학습 노트입니다. ' +
  '튜링 기계와 복잡도 클래스, RSA와 이산로그 기반 암호, 분할 정복과 동적 계획법, ' +
  `볼록 껍질과 최단 경로를 다룹니다. 총 ${totalPosts}편.`;
---

<BaseLayout title={homeTitle} description={homeDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={homeJsonLd} />
  </Fragment>
  <div class="prose home">

    <!-- 에디토리얼 헤드라인 -->
    <h1 class="headline">
      <span class="headline-hl">배운 것</span>을<br />정리하는 개발자
    </h1>
    <p class="desc">
      계산 이론·암호학·알고리즘을 정의부터 증명까지 풀어 정리하는 노트입니다.<br />
      정답보다 그 답에 이르는 과정을 우선합니다.
    </p>

    <!-- 기술 태그 -->
    <div class="tags">
      <span class="tag tag--accent">계산 이론</span>
      <span class="tag tag--accent">암호학</span>
      <span class="tag tag--accent">알고리즘</span>
      <span class="tag">정수론</span>
      <span class="tag">복잡도</span>
      <span class="tag">그리디</span>
    </div>

    <div class="divider"></div>

    <!-- 수평 카테고리 탭 -->
    <nav class="cat-nav" aria-label="카테고리">
      <a class="cat-item cat-active" href="/blog">
        전체 <span class="cat-n">{totalPosts}</span>
      </a>
      {categoryCounts.map((cat) => (
        <a class="cat-item" href={`/categories/${cat.slug}`}>
          {cat.label} <span class="cat-n">{cat.count}</span>
        </a>
      ))}
    </nav>

    <!-- Featured Posts -->
    {featuredPosts.length > 0 && (
      <section class="featured-section">
        <div class="feed-head">
          <h2 class="feed-label">추천 글</h2>
          <span class="feat-sub">주요 카테고리 대표</span>
        </div>
        <div class="featured-list">
          {featuredPosts.map((post) => (
            <a href={`/blog/${post!.id}`} class="feat">
              <div class="feat-meta">
                {post!.data.category && <span class="cat">{getCategoryLabel(post!.data.category)}</span>}
                {post!.data.category && <span class="dot">·</span>}
                <span class="tnum">{fmtDate(post!.data.date)}</span>
              </div>
              <div class="feat-title">{post!.data.title}</div>
              {post!.data.description && <div class="feat-desc">{post!.data.description}</div>}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 최근 글 피드 -->
    <div class="feed-head">
      <h2 class="feed-label">최근 글</h2>
      <a href="/blog" class="feed-more">모두 보기 →</a>
    </div>
    <div class="feed">
      {recentPosts.map((post) => (
        <a href={`/blog/${post.id}`} class="feed-item">
          <span class="feed-date">
            {post.data.date.toLocaleDateString('ko-KR', { month: '2-digit', day: '2-digit' })}
          </span>
          <span class="feed-cat">{post.data.category ? getCategoryLabel(post.data.category) : '—'}</span>
          <span class="feed-title">{post.data.title}</span>
        </a>
      ))}
    </div>

    <div class="section-divider"></div>

    <!-- 카테고리별 포스트 통계 -->
    <div class="section-head">
      <h2 class="section-label">주제별 현황</h2>
      <span class="section-total">총 <strong>{totalPosts}</strong>개</span>
    </div>
    <ul class="bar-list">
      {categoryCounts.map((cat) => (
        <li>
          <a href={`/categories/${cat.slug}`} class="bar-item">
            <span class="bar-label">{cat.label}</span>
            <div class="bar-track">
              <div
                class="bar-fill"
                style={`transform: scaleX(${(cat.count / maxCount).toFixed(3)})`}
              />
            </div>
            <span class="bar-count">{cat.count}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="section-divider"></div>

    <!-- 주제 소개 — 사람에게는 길잡이, 기계에게는 이 사이트가 무엇에 관한 것인지의 근거 -->
    <div class="section-head">
      <h2 class="section-label">여기서 다루는 것</h2>
    </div>
    <div class="topics">
      {homeTopics.map((cat) => (
        <section class="topic">
          <h3 class="topic-name">
            <a href={`/categories/${cat.slug}`}>{cat.label}</a>
            <span class="topic-n">{cat.count}편</span>
          </h3>
          <p class="topic-desc">{topicIntros[cat.slug]}</p>
        </section>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
  .home {
    position: relative;
  }

  /* ── 에디토리얼 헤드라인 ── */
  .headline {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 1.5rem 0 0.75rem;
    border: none;
    text-wrap: balance;
  }
  .headline-hl {
    color: var(--accent);
  }

  .desc {
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.75;
    margin: 0 0 1.25rem;
    text-wrap: pretty;
  }

  /* ── 기술 태그 ── */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.75rem;
  }
  .tag {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    padding: 0.2rem 0.65rem;
    border-radius: 4px;
    background: var(--amber-soft);
    color: var(--amber);
    border: 1px solid transparent;
  }
  .tag--accent {
    background: var(--amber-soft);
    color: var(--amber);
    border-color: var(--amber);
  }

  .divider {
    height: 1px;
    background: var(--rule);
    margin-bottom: 1.5rem;
  }

  /* ── 카테고리 탭 ── */
  .cat-nav {
    display: flex;
    gap: 0;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cat-nav::-webkit-scrollbar { display: none; }

  .cat-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.65rem 1rem;
    min-height: 44px;
    font-size: 0.92rem;
    color: var(--text-dim);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    touch-action: manipulation;
  }
  .cat-item:hover { color: var(--text); border-bottom-color: var(--amber); }
  .cat-item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: 4px;
  }
  .cat-active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }

  .cat-n {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-dim);
  }

  /* ── Featured Posts ── */
  .featured-section { margin-bottom: 1.75rem; }
  .feat-sub { font-size: 0.75rem; color: var(--text-dim); }

  .featured-list { border-bottom: 1px solid var(--rule); }
  .feat {
    display: block;
    text-decoration: none;
    border-top: 1px solid var(--rule);
    padding: 1.15rem 0;
  }
  .feat-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem;
    font-size: 0.76rem; color: var(--text-dim); margin-bottom: 0.45rem;
  }
  .feat-meta .cat { color: var(--accent); font-weight: 700; }
  .feat-meta .dot { color: var(--rule); }
  .feat-meta .tnum { font-variant-numeric: tabular-nums; }
  .feat-title {
    font-family: var(--font-serif);
    font-size: 1.5rem; font-weight: 700; line-height: 1.22;
    letter-spacing: -0.01em; color: var(--text);
    margin-bottom: 0.45rem; text-wrap: balance;
    transition: color 0.12s;
  }
  .feat:hover .feat-title { color: var(--accent); }
  .feat:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .feat-desc {
    font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; text-wrap: pretty;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* ── 피드 ── */
  .feed-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.55rem;
  }
  .feed-label {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text);
  }
  .feed-more {
    font-size: 0.78rem;
    color: var(--text-dim);
    text-decoration: none;
    padding: 0.5rem 0.25rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color 0.15s;
    touch-action: manipulation;
  }
  .feed-more:hover { color: var(--accent); }
  .feed-more:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .feed { display: flex; flex-direction: column; }
  .feed-item {
    display: grid;
    grid-template-columns: 4.5rem auto 1fr;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1.1rem 0.4rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    touch-action: manipulation;
  }
  .feed-item:last-child { border-bottom: none; }
  .feed-item:hover { background: var(--bg-hover); }
  .feed-item:hover .feed-title { color: var(--text); }
  .feed-item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .feed-date  {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }
  .feed-cat   {
    font-family: var(--font-serif);
    font-size: 0.82rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .feed-title {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.12s;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── 섹션 공통 ── */
  .section-divider {
    height: 1px;
    background: var(--rule);
    margin: 2rem 0 1.5rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .section-label {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text);
  }
  .section-total {
    font-size: 0.82rem;
    color: var(--text-dim);
  }
  .section-total strong {
    color: var(--accent);
    font-weight: 700;
  }

  /* ── 바 차트 ── */
  .bar-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .bar-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    padding: 0.25rem 0.4rem;
    margin: 0 -0.4rem;
    border-radius: 6px;
    transition: background 0.12s;
    touch-action: manipulation;
  }
  .bar-item:hover { background: var(--bg-hover); }
  .bar-item:hover .bar-label { color: var(--text); }
  .bar-item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .bar-label {
    font-size: 0.82rem;
    color: var(--text-muted);
    width: 5.5rem;
    flex-shrink: 0;
  }
  .bar-track {
    flex: 1;
    height: 6px;
    background: var(--rule);
    border-radius: 3px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    width: 100%;
    background: var(--accent);
    border-radius: 3px;
    transform-origin: left;
  }
  .bar-count {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    width: 2rem;
    text-align: right;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .bar-fill { transition: none; }
    .cat-item, .feed-item, .feed-more { transition: none; }
    .cat-item:active, .feed-item:active { transform: none; }
    .cat-item:focus-visible, .feed-item:focus-visible, .feed-more:focus-visible {
      transition: none;
    }
    .feed-item { animation: none; }
  }

  /* ── 주제 소개 ── */
  .topics {
    display: flex;
    flex-direction: column;
  }
  .topic {
    border-top: 1px solid var(--rule);
    padding: 1.1rem 0;
  }
  .topic:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .topic-name {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.4rem;
  }
  .topic-name a {
    color: inherit;
    text-decoration: none;
    transition: color 0.12s;
  }
  .topic-name a:hover { color: var(--accent); }
  .topic-name a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 3px;
  }
  .topic-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }
  .topic-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
    text-wrap: pretty;
  }

  /* ── 반응형 ── */
  @media (max-width: 480px) {
    .headline { font-size: 1.65rem; }
    .identity-role { display: none; }
    .feed-item { grid-template-columns: 3.5rem 1fr; }
    .feed-cat { display: none; }
  }
</style>
