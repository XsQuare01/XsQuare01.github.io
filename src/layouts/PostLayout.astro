---
import BaseLayout from './BaseLayout.astro';
import { tagStyle } from '../utils/tagColor';
import { getCategoryLabel } from '../data/categories';
import { difficultyStars } from '../utils/difficulty';
import katex from 'katex';

function renderHeadingText(text: string): string {
  return text.replace(/\$([^$]+)\$/g, (_, math) => {
    try {
      return katex.renderToString(math, { throwOnError: false });
    } catch {
      return `$${math}$`;
    }
  });
}

interface Heading {
  slug: string;
  text: string;
}

interface PostLink {
  slug: string;
  title: string;
  description?: string;
}

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  category?: string;
  difficulty?: '입문' | '초급' | '중급' | '고급' | '심화';
  numbered?: boolean;
  headings?: Heading[];
  readingTime?: number;
  wordCount?: number;
  ogImageUrl?: string;
  prevPost?: PostLink;
  nextPost?: PostLink;
}

const {
  title,
  date,
  description,
  tags = [],
  category,
  difficulty,
  numbered = false,
  headings = [],
  readingTime,
  wordCount,
  ogImageUrl,
  prevPost,
  nextPost,
} = Astro.props;

const formattedDate = date.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const siteUrl = Astro.site?.toString() ?? '';
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const categoryLabel = category ? getCategoryLabel(category) : undefined;

const blogPosting: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description ?? '',
  inLanguage: 'ko',
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  author: {
    '@type': 'Person',
    name: 'XsQuare01',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: 'XsQuare01',
    url: siteUrl,
  },
  url: canonicalURL,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
};
if (ogImageUrl) blogPosting.image = ogImageUrl;
if (wordCount) blogPosting.wordCount = wordCount;
if (tags.length > 0) blogPosting.keywords = tags.join(', ');
if (categoryLabel) blogPosting.articleSection = categoryLabel;

const breadcrumbItems: Array<Record<string, unknown>> = [
  { '@type': 'ListItem', position: 1, name: '홈', item: siteUrl },
];
if (category && categoryLabel) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: categoryLabel,
    item: new URL(`categories/${category}/`, Astro.site).toString(),
  });
}
breadcrumbItems.push({
  '@type': 'ListItem',
  position: breadcrumbItems.length + 1,
  name: title,
  item: canonicalURL,
});
const breadcrumbList = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};

const jsonLd = JSON.stringify([blogPosting, breadcrumbList]);
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={ogImageUrl}
  ogImageAlt={title}
  twitterCardType="summary_large_image"
  articlePublishedTime={date.toISOString()}
  articleModifiedTime={date.toISOString()}
  articleAuthor="XsQuare01"
  articleSection={categoryLabel}
  articleTags={tags}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  {headings.length > 0 && (
    <Fragment slot="toc">
      <div class="toc">
        <div class="toc-title">목차</div>
        <ul class="toc-list">
          {headings.map((h) => (
            <li>
              <a class="toc-link" href={`#${h.slug}`} set:html={renderHeadingText(h.text)} />
            </li>
          ))}
        </ul>
      </div>
    </Fragment>
  )}

  <article>
    {category && (
      <nav class="post-breadcrumb" aria-label="breadcrumb">
        <a href="/">홈</a>
        <span class="post-breadcrumb-sep">›</span>
        <a href={`/categories/${category}`}>{getCategoryLabel(category)}</a>
        <span class="post-breadcrumb-sep">›</span>
        <span>{title}</span>
      </nav>
    )}
    <div class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <span>{formattedDate}</span>
        {readingTime && (
          <span class="reading-time">· 약 {readingTime}분 읽기</span>
        )}
        {difficulty && (
          <span class={`difficulty-badge difficulty-${difficulty}`}>
            {difficultyStars(difficulty)} {difficulty}
          </span>
        )}
        {tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => (
              <a href={`/tags/${tag}`} class="tag" style={tagStyle(tag)}>{tag}</a>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class:list={['prose', { numbered }]}>
      <slot />
    </div>

    {(prevPost || nextPost) && (
      <nav class="post-nav">
        {nextPost ? (
          <a href={`/blog/${nextPost.slug}`} class="post-nav-item prev">
            <span class="post-nav-label">← 다음 글</span>
            <span class="post-nav-title">{nextPost.title}</span>
            {nextPost.description && <span class="post-nav-desc">{nextPost.description}</span>}
          </a>
        ) : <div />}
        {prevPost ? (
          <a href={`/blog/${prevPost.slug}`} class="post-nav-item next">
            <span class="post-nav-label">이전 글 →</span>
            <span class="post-nav-title">{prevPost.title}</span>
            {prevPost.description && <span class="post-nav-desc">{prevPost.description}</span>}
          </a>
        ) : <div />}
      </nav>
    )}
  </article>

  {headings.length > 0 && (
    <div class="mtoc" data-mtoc>
      <button
        class="mtoc-fab"
        type="button"
        aria-label="목차 열기"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="mtoc-sheet"
      >
        <span class="mtoc-bars" aria-hidden="true"></span>
      </button>
      <div class="mtoc-backdrop" data-mtoc-backdrop></div>
      <div class="mtoc-sheet" id="mtoc-sheet" role="dialog" aria-modal="true" aria-label="목차" tabindex="-1">
        <div class="mtoc-grip" aria-hidden="true"></div>
        <div class="mtoc-head"><span class="mtoc-cap">목차</span></div>
        <nav class="mtoc-body" aria-label="목차">
          <ul class="mtoc-list">
            {headings.map((h, i) => (
              <li>
                <a class="mtoc-link" href={`#${h.slug}`}>
                  <span class="mtoc-n">{i + 1}</span>
                  <span set:html={renderHeadingText(h.text)} />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  )}
</BaseLayout>

<script>
  // ── 읽기 진행률 바 ──
  const bar = document.createElement('div');
  bar.id = 'reading-progress';
  bar.setAttribute('aria-hidden', 'true');
  document.body.appendChild(bar);

  function updateProgress() {
    const article = document.querySelector('article');
    if (!article) return;
    const { top, height } = article.getBoundingClientRect();
    const scrolled = Math.min(1, Math.max(0, -top / (height - window.innerHeight)));
    bar.style.width = `${scrolled * 100}%`;
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  // ── 코드 블록 복사 버튼 ──
  document.querySelectorAll('.prose pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.className = 'code-copy-btn';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', '코드 복사');
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code.innerText);
        btn.textContent = 'Copied!';
        btn.classList.add('copied');
        setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
      } catch {
        btn.textContent = '복사 실패';
        setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      }
    });
    (pre as HTMLElement).style.position = 'relative';
    pre.appendChild(btn);
  });

  // ── 이미지 라이트박스 ──
  const lightbox = document.createElement('div');
  lightbox.id = 'image-lightbox';
  lightbox.setAttribute('role', 'dialog');
  lightbox.setAttribute('aria-modal', 'true');
  lightbox.setAttribute('aria-label', '이미지 확대');
  lightbox.innerHTML = `
    <div class="lightbox-backdrop"></div>
    <div class="lightbox-content"></div>
    <button class="lightbox-close" type="button" aria-label="닫기">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <line x1="3" y1="3" x2="13" y2="13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <line x1="13" y1="3" x2="3" y2="13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>`;
  document.body.appendChild(lightbox);

  const closeBtn = lightbox.querySelector('.lightbox-close') as HTMLButtonElement;
  const content = lightbox.querySelector('.lightbox-content') as HTMLElement;
  let lastFocused: HTMLElement | null = null;
  let zoomAbort: AbortController | null = null;

  function closeLightbox() {
    lightbox.classList.remove('open');
    if (zoomAbort) { zoomAbort.abort(); zoomAbort = null; }
    // svg-steps/is-live는 단계 도식을 열 때만 붙는다(아래) — 다음에 일반 이미지를
    // 열 때로 새어 나가지 않게 여기서 함께 벗긴다.
    content.classList.remove('zoom', 'grabbing', 'svg-steps', 'is-live');
    content.innerHTML = '';
    if (lastFocused) {
      lastFocused.focus();
      lastFocused = null;
    }
  }

  lightbox.querySelector('.lightbox-backdrop')!.addEventListener('click', closeLightbox);
  closeBtn.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox.classList.contains('open')) closeLightbox();
  });

  // SVG 다이어그램(벡터)은 화면 맞춤만으로 라벨이 작아 읽기 어렵다.
  // 확대 시 선명한 특성을 살려, SVG에 한해 줌/팬(휠·드래그 / 핀치·1지 이동·더블탭) 엔진을 붙인다.
  const isSvgSrc = (url: string) => /\.svg(?:[?#]|$)/i.test(url);

  type Pt = { x: number; y: number };
  function setupZoom(stage: HTMLElement, image: HTMLImageElement, fallbackW: number, fallbackH: number) {
    const ac = new AbortController();
    const { signal } = ac;
    const MIN = 1, MAX = 6;
    let s = 1, tx = 0, ty = 0, baseW = 0, baseH = 0;

    const apply = () => {
      const SW = stage.clientWidth, SH = stage.clientHeight;
      const sw = baseW * s, sh = baseH * s;
      tx = sw <= SW ? (SW - sw) / 2 : Math.min(0, Math.max(SW - sw, tx));
      ty = sh <= SH ? (SH - sh) / 2 : Math.min(0, Math.max(SH - sh, ty));
      image.style.transform = `translate(${tx}px, ${ty}px) scale(${s})`;
    };
    const fit = () => {
      const SW = stage.clientWidth, SH = stage.clientHeight;
      const iw = fallbackW || image.naturalWidth || 900;
      const ih = fallbackH || image.naturalHeight || 380;
      const k = Math.min((SW * 0.94) / iw, (SH * 0.94) / ih);
      baseW = iw * k; baseH = ih * k;
      image.style.width = `${baseW}px`; image.style.height = `${baseH}px`;
      s = 1; tx = (SW - baseW) / 2; ty = (SH - baseH) / 2; apply();
    };
    const zoomAt = (cx: number, cy: number, factor: number) => {
      const s2 = Math.min(MAX, Math.max(MIN, s * factor)); const k = s2 / s;
      tx = cx - k * (cx - tx); ty = cy - k * (cy - ty); s = s2; apply();
    };
    const rel = (clientX: number, clientY: number): Pt => {
      const r = stage.getBoundingClientRect(); return { x: clientX - r.left, y: clientY - r.top };
    };

    // 인라인 <svg> 클론에는 'complete'가 없다 — 이미 파싱되어 DOM에 붙은 노드라 로드를
    // 기다릴 이유가 없으므로, 그 경우 바로 맞춘다. img일 때는 기존 동작 그대로다.
    if (!('complete' in image) || image.complete) fit(); else image.addEventListener('load', fit, { signal });
    window.addEventListener('resize', fit, { signal });

    stage.addEventListener('wheel', (e) => {
      e.preventDefault();
      const p = rel(e.clientX, e.clientY);
      zoomAt(p.x, p.y, e.deltaY < 0 ? 1.15 : 1 / 1.15);
    }, { passive: false, signal });

    let dragging = false, px = 0, py = 0;
    stage.addEventListener('mousedown', (e) => { dragging = true; px = e.clientX; py = e.clientY; stage.classList.add('grabbing'); }, { signal });
    window.addEventListener('mousemove', (e) => {
      if (!dragging) return;
      tx += e.clientX - px; ty += e.clientY - py; px = e.clientX; py = e.clientY; apply();
    }, { signal });
    window.addEventListener('mouseup', () => { dragging = false; stage.classList.remove('grabbing'); }, { signal });

    stage.addEventListener('dblclick', (e) => {
      const p = rel(e.clientX, e.clientY);
      if (s > 1.05) fit(); else zoomAt(p.x, p.y, 2.6 / s);
    }, { signal });

    const pts = new Map<number, Pt>();
    let pinchDist = 0, pinchMid: Pt = { x: 0, y: 0 }, lastTap = 0, panPrev: Pt | null = null;
    const dist = (a: Pt, b: Pt) => Math.hypot(a.x - b.x, a.y - b.y);
    stage.addEventListener('touchstart', (e) => {
      e.preventDefault();
      for (const t of Array.from(e.changedTouches)) pts.set(t.identifier, rel(t.clientX, t.clientY));
      const v = Array.from(pts.values());
      if (v.length === 2) { pinchDist = dist(v[0], v[1]); pinchMid = { x: (v[0].x + v[1].x) / 2, y: (v[0].y + v[1].y) / 2 }; }
      else if (v.length === 1) {
        const now = Date.now();
        if (now - lastTap < 300) { if (s > 1.05) fit(); else zoomAt(v[0].x, v[0].y, 2.6 / s); }
        lastTap = now; panPrev = v[0];
      }
    }, { passive: false, signal });
    stage.addEventListener('touchmove', (e) => {
      e.preventDefault();
      for (const t of Array.from(e.changedTouches)) if (pts.has(t.identifier)) pts.set(t.identifier, rel(t.clientX, t.clientY));
      const v = Array.from(pts.values());
      if (v.length === 2) {
        const nd = dist(v[0], v[1]); const mid: Pt = { x: (v[0].x + v[1].x) / 2, y: (v[0].y + v[1].y) / 2 };
        if (pinchDist > 0) zoomAt(mid.x, mid.y, nd / pinchDist);
        tx += mid.x - pinchMid.x; ty += mid.y - pinchMid.y; apply();
        pinchDist = nd; pinchMid = mid;
      } else if (v.length === 1 && s > 1) {
        if (panPrev) { tx += v[0].x - panPrev.x; ty += v[0].y - panPrev.y; apply(); }
        panPrev = v[0];
      }
    }, { passive: false, signal });
    stage.addEventListener('touchend', (e) => {
      for (const t of Array.from(e.changedTouches)) pts.delete(t.identifier);
      if (pts.size < 2) { pinchDist = 0; panPrev = null; }
    }, { signal });

    return ac;
  }

  // 라이트박스를 여는 동작 하나를 두 대상에 재사용한다: .prose img(마크다운 이미지,
  // src로 svg 여부를 가린다)와 .svg-steps svg(인라인된 단계 도식, 이미 svg임이 확정돼
  // 있다). 여는 방식이 img.src를 fetch하는 게 아니라 엘리먼트 자체를 cloneNode(true)
  // 하는 것이므로, <svg>에도 그대로 통한다 — 현재 단계의 is-hidden 클래스까지 클론에
  // 그대로 남는다.
  function bindLightbox(el: Element, forceSvg: boolean) {
    (el as HTMLElement).style.cursor = 'zoom-in';
    el.addEventListener('click', () => {
      lastFocused = document.activeElement as HTMLElement;
      const clone = el.cloneNode(true) as HTMLImageElement;
      clone.removeAttribute('width');
      clone.removeAttribute('height');
      const origRect = el.getBoundingClientRect();
      content.innerHTML = '';
      content.appendChild(clone);
      lightbox.classList.add('open');
      if (forceSvg || isSvgSrc(clone.currentSrc || clone.src || '')) {
        if (forceSvg) {
          // 클론이 들고 온 is-hidden 클래스가 실제로 숨겨지려면, 그걸 숨기는 CSS
          // 규칙(.svg-steps.is-live svg g[data-step].is-hidden)의 조상 조건이 이
          // 컨테이너에도 걸려 있어야 한다. 본문의 figure 밖으로 나온 클론이므로 여기서
          // 직접 켠다 — 닫을 때 위 closeLightbox가 벗긴다.
          content.classList.add('svg-steps', 'is-live');
        }
        content.classList.add('zoom');
        zoomAbort = setupZoom(content, clone, origRect.width, origRect.height);
      } else {
        clone.style.cursor = 'zoom-out';
        clone.addEventListener('click', closeLightbox);
      }
      closeBtn.focus();
    });
  }

  document.querySelectorAll('.prose img').forEach((el) => bindLightbox(el, false));

  // 단계 도식은 <img>가 아니라 인라인 <svg>라 위 선택자에 걸리지 않는다. 별도 바인딩으로
  // 덧붙인다 — 여기서 실패해도 위 .prose img 바인딩은 이미 끝나 있어 영향이 없다.
  try {
    document.querySelectorAll('.svg-steps svg').forEach((el) => bindLightbox(el, true));
  } catch {
    // 무시: 단계 도식의 확대만 빠지고, 나머지 이미지의 라이트박스는 정상 동작한다
  }

  // ── TOC 활성 링크 ──
  const headings = document.querySelectorAll('article h2[id]');
  const tocLinks = document.querySelectorAll('.toc-link');

  if (headings.length > 0 && tocLinks.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            tocLinks.forEach((link) => {
              link.classList.remove('active');
              link.removeAttribute('aria-current');
            });
            const active = document.querySelector(
              `.toc-link[href="#${entry.target.id}"]`
            );
            if (active) {
              active.classList.add('active');
              active.setAttribute('aria-current', 'true');
            }
          }
        }
      },
      { rootMargin: '0px 0px -80% 0px' }
    );
    headings.forEach((h) => observer.observe(h));
  }

  // ── 모바일 목차 (FAB + 바텀시트, ≤768px) ──
  const mtoc = document.querySelector('[data-mtoc]');
  if (mtoc) {
    const fab = mtoc.querySelector('.mtoc-fab') as HTMLButtonElement;
    const backdrop = mtoc.querySelector('.mtoc-backdrop') as HTMLElement;
    const sheet = mtoc.querySelector('.mtoc-sheet') as HTMLElement;
    const links = Array.from(mtoc.querySelectorAll('.mtoc-link')) as HTMLAnchorElement[];
    const h2s = Array.from(document.querySelectorAll('article h2[id]')) as HTMLElement[];
    let mtocReturn: HTMLElement | null = null;

    // 닫힘 상태에선 시트를 접근성 트리·탭 순서에서 제외
    sheet.setAttribute('inert', '');

    const currentIndex = () => {
      let idx = 0;
      h2s.forEach((h, i) => { if (h.getBoundingClientRect().top < 90) idx = i; });
      return idx;
    };
    const markCurrent = () => {
      const c = currentIndex();
      links.forEach((a, i) => a.classList.toggle('active', i === c));
      return c;
    };
    const openSheet = () => {
      const c = markCurrent();
      sheet.classList.add('is-open');
      backdrop.classList.add('is-open');
      sheet.removeAttribute('inert');
      fab.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      mtocReturn = document.activeElement as HTMLElement;
      const cur = links[c];
      if (cur) cur.scrollIntoView({ block: 'center' });
      sheet.focus();
    };
    const closeSheet = (restoreFocus = true) => {
      sheet.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      sheet.setAttribute('inert', '');
      fab.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (restoreFocus && mtocReturn) mtocReturn.focus();
      mtocReturn = null;
    };

    fab.addEventListener('click', openSheet);
    backdrop.addEventListener('click', () => closeSheet());
    // 항목 선택 시: 시트를 닫되 포커스는 본문 대상 절로 넘어가도록 복귀 생략
    links.forEach((a) => a.addEventListener('click', () => closeSheet(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sheet.classList.contains('is-open')) closeSheet();
    });

    // FAB 등장/숨김: 헤더를 지나면 등장, 최하단(다음글·푸터)에선 숨김
    const onScroll = () => {
      const y = window.scrollY;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      fab.classList.toggle('is-visible', y > 140 && y < max - 160);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // ── SVG 단계 재생기 ──
  // .svg-steps는 별도 wrapper가 아니라, rehypeSvgSteps가 클래스를 얹은 figure 자신이다.
  // 이 클래스가 없는 글에서는 querySelectorAll 결과가 비어 아무 일도 하지 않는다.
  document.querySelectorAll('.svg-steps').forEach((fig) => {
    const steps = [...fig.querySelectorAll('svg g[data-step]')].sort(
      (a, b) => Number(a.dataset.step) - Number(b.dataset.step)
    );
    if (steps.length < 2) return; // 단계가 1개 이하면 컨트롤을 만들 이유가 없다

    const controls = document.createElement('div');
    controls.className = 'step-controls';
    const prev = document.createElement('button');
    const next = document.createElement('button');
    prev.type = next.type = 'button';
    prev.textContent = '◀ 이전';
    next.textContent = '다음 ▶';
    prev.setAttribute('aria-label', '이전 단계');
    next.setAttribute('aria-label', '다음 단계');
    const counter = document.createElement('span');
    counter.className = 'step-counter';
    const label = document.createElement('span');
    label.className = 'step-label';
    // counter와 label을 하나의 라이브 리전으로 묶는다 — 따로면 위치(counter)는
    // 스크린리더에 전혀 알려지지 않고 설명(label)만 알려진다
    const status = document.createElement('span');
    status.className = 'step-status';
    status.setAttribute('aria-live', 'polite');
    // counter와 label을 별도로 알리면 두 번 바뀐 알림으로 나뉜다. 한 발화로 묶는다.
    status.setAttribute('aria-atomic', 'true');
    status.append(counter, label);
    controls.append(prev, status, next);
    // figcaption은 HTML 콘텐츠 모델상 figure의 첫 또는 마지막 자식이어야 한다.
    // 컨트롤을 append하면 svg, figcaption, div 순으로 figcaption이 중간 자식이 된다.
    // figcaption 앞에 넣어 컨트롤이 도식 바로 아래, figcaption보다 앞에 오게 한다.
    // figcaption이 없으면 insertBefore(node, null)은 appendChild와 같이 동작해 안전하다.
    fig.insertBefore(controls, fig.querySelector('figcaption'));

    let at = 1;
    const render = () => {
      // 숨김은 값(data-step) 대신 정렬된 배열의 인덱스로 판단한다. steps[at - 1]로
      // 라벨을 읽는 아래 줄과 같은 기준을 써야, data-step이 1..N 연속·중복 없음을
      // 요구하지 않는다 — 단계를 지우거나 번호를 건너뛰어도 "몇 번째"만 맞으면 된다.
      steps.forEach((g, i) => {
        g.classList.toggle('is-hidden', i + 1 > at);
      });
      counter.textContent = `${at}/${steps.length}`;
      label.textContent = steps[at - 1].dataset.stepLabel || '';
      // disabled 대신 aria-disabled만 표시한다: 끝 단계에서 disabled를 주면 포커스를
      // 쥔 버튼이 브라우저의 포커스 보정 규칙으로 body로 쫓겨나 화살표 키가 죽는다.
      // 버튼은 계속 포커스 가능한 상태로 두고, 실제 이동 차단은 아래 클릭/키다운
      // 핸들러의 범위 검사(at > 1 / at < steps.length)에 맡긴다.
      prev.setAttribute('aria-disabled', String(at === 1));
      next.setAttribute('aria-disabled', String(at === steps.length));
    };

    prev.addEventListener('click', () => { if (at > 1) { at -= 1; render(); } });
    next.addEventListener('click', () => { if (at < steps.length) { at += 1; render(); } });
    controls.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' && at > 1) { at -= 1; render(); }
      else if (e.key === 'ArrowRight' && at < steps.length) { at += 1; render(); }
      else return;
      e.preventDefault();
    });

    render();
    // 이 클래스가 붙기 전까지는 CSS가 어떤 단계도 숨기지 않는다(JS 실패 시 전체 도식 유지).
    // render() 다음에 붙여서, render() 안에서 예외가 나도 레이어는 숨겨지고 컨트롤만
    // 죽어 있는 상태(is-live는 이미 켜졌는데 render가 못 끝난 상태)를 만들지 않는다.
    fig.classList.add('is-live');
  });
</script>
